TELEGRAM_BOT_TOKEN=replace-me
# Optional: set this after running /chat_id in the target group.
# If empty, the bot binds itself to the first group that sends /chat_id.
TELEGRAM_CHAT_ID=

SQLITE_PATH=./data/bot.db
POLL_SCHEDULER_ENABLED=true
# Every Friday at noon (Europe/Moscow).
POLL_CRON=0 12 * * 5
TIMEZONE=Europe/Moscow
